{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orenda:maintenance-history:v1",
  "title": "Orenda maintenance history import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "orenda.maintenance-history.v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalId",
          "revision",
          "machineId",
          "source",
          "kind",
          "status",
          "occurredAt",
          "description"
        ],
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "machineId": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "assetId"
            ],
            "properties": {
              "system": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "\\S"
              },
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "workOrderId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          },
          "kind": {
            "enum": [
              "inspection",
              "repair",
              "service",
              "part_replacement",
              "calibration",
              "failure",
              "verification"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "failureCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "outcome": {
            "enum": [
              "improved",
              "unchanged",
              "worse",
              "no_fault",
              "fault_confirmed",
              "not_recorded"
            ]
          },
          "parts": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "partNumber",
                "quantity",
                "unit"
              ],
              "properties": {
                "action": {
                  "enum": [
                    "replaced",
                    "consumed",
                    "inspected"
                  ]
                },
                "positionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "partNumber": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                },
                "installedSerial": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "removedSerial": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                }
              }
            }
          },
          "meterReadings": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
